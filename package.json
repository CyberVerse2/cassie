{
  "name": "cassie",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "cassie": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "web:dev": "next dev apps/web",
    "web:build": "next build apps/web && cp -R apps/web/public apps/web/.next/standalone/apps/web/public && cp -R apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static",
    "web:start": "node --import dotenv/config apps/web/.next/standalone/apps/web/server.js",
    "og:trade": "tsx scripts/capture-og.ts",
    "worker": "tsx watch src/worker.ts",
    "cli": "tsx src/cli.ts",
    "hyperliquid:approve-builder": "tsx scripts/approve-hyperliquid-builder-fee.ts",
    "smoke:v4-flash": "tsx scripts/test-v4-flash.ts",
    "smoke:polymarket-clob": "tsx scripts/test-polymarket-clob.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.78",
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/xai": "^3.0.91",
    "@nktkas/hyperliquid": "^0.32.2",
    "@polymarket/client": "^0.1.0-beta.2",
    "@privy-io/node": "^0.15.0",
    "@privy-io/react-auth": "^3.27.2",
    "ai": "^6.0.185",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ethers": "^6.16.0",
    "graphile-worker": "^0.16.6",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "string-width": "^8.2.1",
    "tsx": "^4.22.3",
    "viem": "^2.50.4",
    "wrap-ansi": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
