# better-auth: Dash API key (doubles as the session secret unless
# BETTER_AUTH_SECRET is set) and the login X app's OAuth2 credentials.
# The base URL is derived from request headers (host/x-forwarded-*) validated
# against BETTER_AUTH_ALLOWED_HOSTS; set BETTER_AUTH_URL to pin it instead.
BETTER_AUTH_API_KEY=
BETTER_AUTH_X_CLIENT_ID=
BETTER_AUTH_X_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_ALLOWED_HOSTS=cassie.trade,*.cassie.trade,localhost:3000
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_DEPOSITS_WALLET_SET_ID=
CIRCLE_TREASURY_WALLET_ID=
CIRCLE_TREASURY_WALLET_ADDRESS=
# Testnet is the default; set CIRCLE_TESTNET=0 for mainnet.
CIRCLE_TESTNET=
CIRCLE_DEFAULT_CHAIN=arc
# Paper trading: simulate venue fills at live prices instead of sending real
# orders. Defaults to CIRCLE_TESTNET; set 0/1 to override explicitly.
CASSIE_SIMULATED_EXECUTION=
CIRCLE_TRANSACTION_POLL_INTERVAL_MS=1500
CIRCLE_TRANSACTION_POLL_TIMEOUT_MS=120000
CASSIE_DEPOSIT_POLL_INTERVAL_MINUTES=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_CONNECT_TTL_MS=600000
PORT=3000
